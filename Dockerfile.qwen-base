FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ libgomp1 curl && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir transformers accelerate Pillow
ARG HF_TOKEN=""
ENV HF_TOKEN=${HF_TOKEN}
# download once, cached forever — only rebuild this image when upgrading the model
RUN python -c "\
from transformers import AutoProcessor, AutoModelForMultimodalLM; \
AutoProcessor.from_pretrained('Qwen/Qwen3.5-0.8B'); \
AutoModelForMultimodalLM.from_pretrained('Qwen/Qwen3.5-0.8B')"
